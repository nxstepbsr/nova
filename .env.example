# Copy this file to .env.local and fill in your keys.

# REQUIRED — unlike everything else below, this one fails closed: without
# it, every route (except /login and published /p/[id] pages) returns 500
# instead of quietly allowing access. This is the one shared password that
# gates the whole app; there's no separate secret to configure, it also
# signs the session cookie.
APP_PASSWORD=

# Without it, /api/edit returns 503 and the app falls back to the
# deterministic interpret() in lib/site/interpret.ts.
ANTHROPIC_API_KEY=

# Without it, /api/voice-token returns 503 and the Mic button falls back to
# one-shot browser speech-to-text (fills the composer, no live conversation).
# With it, Mic starts a real voice session via OpenAI's Realtime API — the
# session's update_site tool still routes through /api/edit (Claude) above,
# it's just a spoken entry point into the same pipeline.
OPENAI_API_KEY=

# Optional override if OpenAI renames/retires the default below.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Without these, "Publish demo" falls back to a local node:sqlite file
# (data/canvas.db) that only survives `npm run dev` — fine locally, but a
# real deploy's serverless filesystem is ephemeral, so published sites
# wouldn't persist. Set these (install the "Upstash for Vercel" integration
# from the Vercel Marketplace, or bring your own Upstash account) and
# publishing switches to real, persistent storage automatically — no code
# changes needed. Vercel's own KV_REST_API_URL/KV_REST_API_TOKEN naming
# works here too; only one pair is required.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
